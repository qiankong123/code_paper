{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${fileDirname}"
            },
            "stopOnEntry": false
        },
        {
            "name": "调试指定文件（输入文件名）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/${input:pythonFile}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "stopOnEntry": false
        },
        {
            "name": "调试 05 指纹生成",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/05_random_matrix_fingerprint.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "调试 06 汉明相似度",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/06_hamming_similarity.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "调试 07 鲁棒聚合",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/07_robust_aggregation.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}